# ==============================================================================
# GlobeTrotter Monorepo - Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Compiled & Build Artifacts
dist/
*/dist/
build/
*/build/
.next/
*/.next/
out/
*/out/

# Environment and Secrets (CRITICAL: Never commit real credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*/.env
*/.env.local
*/.env.development.local
*/.env.test.local
*/.env.production.local
!*.env.example
!*/*.env.example

# Local Uploads & Static Media (Keep placeholder)
uploads/*
backend/uploads/*
!uploads/.gitkeep
!backend/uploads/.gitkeep

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# Testing & Coverage
coverage/
*/coverage/
.nyc_output/
*.lcov

# Temporary files & logs
logs/
*.log
tmp/
temp/
