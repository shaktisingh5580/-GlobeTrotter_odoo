# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (PostgreSQL 16 via Docker port 5434)
DATABASE_URL=postgresql://globetrotter:globetrotter_dev_pass@localhost:5434/globetrotter?schema=public

# Authentication & Security
JWT_SECRET=super_secret_globetrotter_jwt_key_development_only_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
